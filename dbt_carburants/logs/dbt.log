  create  table "carburants"."silver_gold"."gold_stats_region__dbt_tmp"
  
  
    as
  
  (
    
SELECT s.region ,
 s.departement,
 s.code_departement,
 p.carburant ,
 count(distinct s.id) as nb_stations,
 ROUND(AVG(p.prix)::numeric  ,3) as prix_moyen,
 MIN(p.prix) as prix_min,
 MAX(p.prix) as prix_max

from
"carburants"."silver_silver"."silver_stations" s
inner join "carburants"."silver_silver"."silver_prices" p 
    on s.id = p.id
group by 
    s.region, 
    s.departement, 
    s.code_departement, 
    p.carburant
  );
  
