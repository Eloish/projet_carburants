        else null
    end as lon_gps,

    case
        when cast(gazole_prix as double precision) between 0.50 and 5.00 then cast(gazole_prix as double precision)
        else null
    end as gazole_prix,
    case
        when cast(sp95_prix as double precision) between 0.50 and 5.00 then cast(sp95_prix as double precision)
        else null
    end as sp95_prix,
    case
