  create view "carburants"."silver"."silver_stations__dbt_tmp"
    
    
  as (
    {
{ config
(materialized='table', schema='silver') }}

select
    id,
    nullif(trim(adresse), '') as adresse,
    nullif(trim(ville), '') as ville,
    nullif(trim(cp), '') as cp,
    nullif(trim(departement), '') as departement,
    nullif(trim(region), '') as region,
    nullif(trim(code_departement), '') as code_departement,

    case
        when cast(latitude as double precision) between -90 and 90 then cast(latitude as double precision)
        else null
    end as latitude,
    case
        when cast(longitude as double precision) between -180 and 180 then cast(longitude as double precision)
        else null
    end as longitude,

    case
        when cast(latitude as double precision) between -90 and 90 then cast(latitude as double precision)
        else null
    end as lat_gps,
    case
        when cast(longitude as double precision) between -180 and 180 then cast(longitude as double precision)
        else null
    end as lon_gps,

    case
        when cast(gazole_prix as double precision) between 0.50 and 5.00 then cast(gazole_prix as double precision)
        else null
    end as gazole_prix,
    case
        when cast(sp95_prix as double precision) between 0.50 and 5.00 then cast(sp95_prix as double precision)
        else null
    end as sp95_prix,
    case
