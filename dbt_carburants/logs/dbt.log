from "carburants"."public"."carburants_raw"
where e10_prix is not null

union all

select
    id,
    'e85' as carburant,
    cast(e85_prix as double precision) as prix
from "carburants"."public"."carburants_raw"
where e85_prix is not null

union all

select
    id,
    'gplc' as carburant,
